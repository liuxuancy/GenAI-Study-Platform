{
  "description": [
    "权限码匹配的共用测试用例，前后端测试都会用 Match(granted, required) 逐条跑一遍。",
    "权限码格式：使用方:资源:动作，例如 teacher:course:create。",
    "  使用方：谁在用这个功能，system（管理员）、teacher（讲师）、student（学生）",
    "  资源：操作的对象，如 user、course、lesson",
    "  动作：做什么，如 view、create、update、delete",
    "匹配规则：",
    "  按 : 分段逐段比较，不是字符串前缀匹配",
    "  * 只能作为完整的最后一段，匹配剩余的一段或多段，如 teacher:* 覆盖 teacher:course:view",
    "  格式非法的权限码一律不匹配；区分大小写",
    "granted 是角色被授予的权限码，required 是接口要求的权限码，match 是期望结果。"
  ],
  "cases": [
    { "granted": "teacher:course:view", "required": "teacher:course:view",   "match": true,  "note": "完全相同" },
    { "granted": "teacher:course:view", "required": "teacher:course:create", "match": false, "note": "动作不同" },
    { "granted": "teacher:course:view", "required": "teacher:course",        "match": false, "note": "授予的比要求的长" },
    { "granted": "teacher:course",      "required": "teacher:course:view",   "match": false, "note": "没有 '*' 就不做前缀匹配" },

    { "granted": "teacher:*",           "required": "teacher:course:view",   "match": true,  "note": "使用方通配覆盖 资源:动作" },
    { "granted": "teacher:*",           "required": "teacher:lesson:create", "match": true,  "note": "使用方通配覆盖任意资源" },
    { "granted": "teacher:*",           "required": "teacher:x",             "match": true,  "note": "通配可以只匹配一段" },
    { "granted": "teacher:*",           "required": "teacher",               "match": false, "note": "通配至少要匹配一段" },
    { "granted": "teacher:*",           "required": "teachers:item:view",    "match": false, "note": "按段匹配，不是字符串前缀" },
    { "granted": "teacher:*",           "required": "student:lesson:view",   "match": false, "note": "其他使用方" },
    { "granted": "teacher:course:*",    "required": "teacher:course:view",   "match": true,  "note": "资源级通配" },
    { "granted": "teacher:course:*",    "required": "teacher:lesson:view",   "match": false, "note": "资源级通配不覆盖其他资源" },

    { "granted": "*",                   "required": "system:user:view",      "match": true,  "note": "全局通配" },
    { "granted": "*",                   "required": "teacher:*",             "match": true,  "note": "全局通配覆盖通配要求" },
    { "granted": "*",                   "required": "*",                     "match": true,  "note": "全局通配覆盖自身" },

    { "granted": "teacher:*",           "required": "teacher:*",             "match": true,  "note": "通配要求需要同等的授予" },
    { "granted": "teacher:course:view", "required": "teacher:*",             "match": false, "note": "具体授予不满足通配要求" },
    { "granted": "teacher:course:*",    "required": "teacher:*",             "match": false, "note": "窄通配不满足宽通配要求" },

    { "granted": "teacher:*:view",      "required": "teacher:course:view",   "match": false, "note": "非法授予：'*' 不在最后一段" },
    { "granted": "teacher:cour*",       "required": "teacher:course",        "match": false, "note": "非法授予：段内部分通配" },
    { "granted": "teacher::view",       "required": "teacher::view",         "match": false, "note": "非法授予：空段" },
    { "granted": "teacher:",            "required": "teacher:",              "match": false, "note": "非法授予：结尾冒号" },
    { "granted": "",                    "required": "teacher:course:view",   "match": false, "note": "非法授予：空字符串" },
    { "granted": "*",                   "required": "",                      "match": false, "note": "非法要求：空字符串" },
    { "granted": "*",                   "required": "teacher:*:view",        "match": false, "note": "非法要求：'*' 不在最后一段" },

    { "granted": "Teacher:course:view", "required": "teacher:course:view",   "match": false, "note": "区分大小写" },
    { "granted": "system:*",            "required": "teacher:course:view",   "match": false, "note": "无关使用方的通配" }
  ]
}
