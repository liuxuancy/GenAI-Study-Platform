# 复制到 /etc/systemd/system/caveclass.service 后： systemctl daemon-reload && systemctl enable --now caveclass
[Unit]
Description=CaveClass API
After=network.target

[Service]
Type=simple
WorkingDirectory=/www/wwwroot/caveclass/backend
EnvironmentFile=/www/wwwroot/caveclass/backend/.env
Environment=APP_ENV=prod
Environment=HTTP_ADDR=127.0.0.1:8080
Environment=DB_PATH=data/caveclass.db
ExecStart=/www/wwwroot/caveclass/backend/bin/caveclass-server
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
