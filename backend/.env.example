# 复制为本目录的 .env 后再填写。 .env 已被 git 忽略，不要提交密钥。
# 库代码只读进程环境变量。本地真实调用：在 backend 目录执行 go run ./cmd/ai-live

AI_PROVIDER=mock
AI_API_KEY=
AI_BASE_URL=
AI_MODEL_PRIMARY=
AI_MODEL_FALLBACK=
AI_TIMEOUT=180s
AI_MAX_RETRIES=1
AI_MAX_TOPIC_LEN=500

# 网页与整站生成：推荐同时配置两把密钥，前端可切换 DeepSeek / Teamily。
# 服务端默认厂商仍看 AI_PROVIDER；未传 provider 时跟 AI_PROVIDER 或第一个有密钥的厂商。
AI_DEEPSEEK_API_KEY=
AI_TEAMILY_API_KEY=
AI_DEEPSEEK_BASE_URL=
AI_TEAMILY_BASE_URL=
AI_DEEPSEEK_MODEL_PRIMARY=deepseek-chat
AI_TEAMILY_MODEL_PRIMARY=teamily
# AI_PLAYGROUND_ADDR=127.0.0.1:8765

# DeepSeek。AI_MODEL_PRIMARY 为空时使用 deepseek-chat。
# AI_PROVIDER=deepseek
# AI_API_KEY=sk-your-deepseek-key
# AI_MODEL_PRIMARY=deepseek-chat
# AI_BASE_URL=https://api.deepseek.com/chat/completions

# Teamily agent responses。AI_BASE_URL 为空时使用代码里的默认 agent 地址。
# AI_PROVIDER=teamily
# AI_API_KEY=tmly_sk_live_your-key
# AI_BASE_URL=https://teamily.ai/v1/agents/<agent-id>/responses

# 腾讯云 COS（课程资料私有存储，仅服务端读取；勿写入 VITE_ 或提交 Git）
# 旧广州桶示例（已停用）
# COS_BUCKET=caveclass-resources-1385365202
# COS_REGION=ap-guangzhou
# Host: caveclass-resources-1385365202.cos.ap-guangzhou.myqcloud.com
# 香港桶（当前推荐）
COS_BUCKET=caveclass-resources-hk-1385365202
COS_REGION=ap-hongkong
# Host: caveclass-resources-hk-1385365202.cos.ap-hongkong.myqcloud.com
COS_SECRET_ID=
COS_SECRET_KEY=
# COS_DOC_MAX_BYTES=52428800
# COS_ARCHIVE_MAX_BYTES=524288000
# COS_PRESIGN_TTL_SEC=900
# PPT/DOC/XLS 在线预览（默认关闭）：须在 Bucket 开通「数据万象 → 文档预览 doc-preview」后设为 true，并重启后端。
# 未开启时 API 对 pptx 等返回 kind=unsupported，前端提示「请下载查看」。
# COS_DOC_PREVIEW_ENABLED=true

# 日志（github.com/liuxuancy/Libs/logs）。都不填时：服务名 cave_class，环境跟随 APP_ENV，dev 打 debug，不抄送日志平台。
# LOG_SERVICE_NAME=cave_class
# LOG_ENVIRONMENT=dev
# LOG_LEVEL=debug
# LOG_PLATFORM_ENABLED=true
# LOG_PLATFORM_URL=https://日志平台地址/api/logs/ingest
# LOG_PLATFORM_KEY=
