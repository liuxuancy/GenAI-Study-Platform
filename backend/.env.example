# 复制为本目录的 .env 后再填写。 .env 已被 git 忽略，不要提交密钥。
# 库代码只读进程环境变量。本地真实调用：在 backend 目录执行 go run ./cmd/ai-live

AI_PROVIDER=mock
AI_API_KEY=
AI_BASE_URL=
AI_MODEL_PRIMARY=
AI_MODEL_FALLBACK=
AI_TIMEOUT=180s
AI_MAX_RETRIES=1
AI_MAX_TOPIC_LEN=500

# DeepSeek。AI_MODEL_PRIMARY 为空时使用 deepseek-chat。
# AI_PROVIDER=deepseek
# AI_API_KEY=sk-your-deepseek-key
# AI_MODEL_PRIMARY=deepseek-chat
# AI_BASE_URL=https://api.deepseek.com/chat/completions

# Teamily agent responses。AI_BASE_URL 为空时使用代码里的默认 agent 地址。
# AI_PROVIDER=teamily
# AI_API_KEY=tmly_sk_live_your-key
# AI_BASE_URL=https://teamily.ai/v1/agents/<agent-id>/responses
